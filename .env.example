# 配置中心创建项目后，将项目 URL 中的 UUID 填到这里。
FAY_CONFIG_CENTER_ID=

# 配置中心 API key，必须在 Fay 和配置中心服务中保持一致。
FAY_CONFIG_CENTER_API_KEY=local-fay-api-key-change-me

# 配置中心 Flask session 密钥，建议改成随机长字符串并保持不变。
FAY_CONFIG_CENTER_SECRET_KEY=local-fay-secret-key-change-me

# 容器内使用 Compose 服务名访问配置中心，不要改成 localhost。
FAY_CONFIG_CENTER_URL=http://fay-config-server:5500